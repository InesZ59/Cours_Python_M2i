# stockline.service — unité systemd de l'API StockLine Lite
# Destination sur le serveur : /etc/systemd/system/stockline.service
#
# Installation :
#   sudo cp stockline.service /etc/systemd/system/stockline.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now stockline

 

[Unit]
# Description affichée par systemctl status
Description=API StockLine Lite (FastAPI/uvicorn) — formation Utopios
# Ne démarrer qu'une fois la pile réseau initialisée
After=network.target

 

[Service]
# Utilisateur système dédié, sans shell : si l'application est compromise,
# l'attaquant n'obtient ni sudo ni session interactive
User=stockline
Group=stockline
# Répertoire de travail : là où se trouve main.py
WorkingDirectory=/opt/stockline/app
# Chemin de la base SQLite, lu par main.py (variable d'environnement)
Environment=STOCKLINE_DB=/opt/stockline/data/stockline.db
# Commande lancée par systemd : uvicorn du venv, en écoute LOCALE uniquement
# (c'est nginx qui expose le port 80 vers l'extérieur)
ExecStart=/opt/stockline/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
# Auto-réparation : si le processus sort en erreur, systemd le relance
Restart=on-failure
# ... après 3 secondes d'attente (évite les boucles de redémarrage frénétiques)
RestartSec=3

 

[Install]
# Démarrage automatique au boot (cible multi-utilisateurs standard des serveurs)
WantedBy=multi-user.target


